<?xml version="1.0" encoding="utf-8"?>
<!--
  开屏专用的雪山标记（仅图形，无底色）。

  为什么不复用 @mipmap/ic_launcher：系统启动画面默认拿桌面图标绘制，
  而桌面图标是 adaptive-icon（白底 + 雪山前景），会连图标自身的遮罩与留白一起带出来。
  这里单独给一幅透明底的矢量，挂到 android:windowSplashScreenAnimatedIcon 上。

  几何**逐点对齐** @drawable/ic_launcher_foreground（同一套 120 单位网格）：
    山体 (22,104)-(58,36)-(94,104)、右侧暗面 (58,36)-(94,104)-(58,104)、
    雪帽 (58,36)-(71,64)-(58,56)-(45,64)、旗杆 x=57.6 / y=18.2→34.8 / 粗 4.4、
    旗面 (59.8,16)-(79,22.5)-(59.8,29)。

  换算：X = 144 + (x−58)×1.30，Y = 144 + (y−60)×1.30，
  即设计网格中心 (58,60) 对齐 288 视口中心，整枚**等比**放大 1.30 倍。

  等比是关键：旧版横竖用了不同系数（1.36 / 1.20），山体被压扁，
  旗子跟着变形、杆也比图标短一截，和桌面图标一眼就能看出不是同一枚；
  旧版还是扁平青蓝 + 与杆同色的旗，而图标是蓝色渐变 + 更亮的琥珀旗。
  等比之后内容约 94×114，与旧版 98×113 的占位基本一致，不会顶到状态栏。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">

    <!-- 山体正面：与桌面图标同一组渐变 -->
    <path android:pathData="M97.2,201.2 L144,112.8 L190.8,201.2 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="107.6"
                android:startY="112.8"
                android:endX="159.6"
                android:endY="201.2">
                <item android:offset="0" android:color="#FF3FA2FF" />
                <item android:offset="0.5" android:color="#FF0F86F5" />
                <item android:offset="1" android:color="#FF0B6AD1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 右侧暗面：受光 / 背光两个面 -->
    <path
        android:pathData="M144,112.8 L190.8,201.2 L144,201.2 Z"
        android:fillColor="#400B5DBD" />

    <!-- 雪帽：两瓣、中间上凹 -->
    <path
        android:pathData="M144,112.8 L160.9,149.2 L144,138.8 L127.1,149.2 Z"
        android:fillColor="#FFFFFFFF" />

    <!-- 旗杆：圆头线，粗细与图标一致（4.4 × 1.30 = 5.72） -->
    <path
        android:pathData="M143.48,89.66 L143.48,111.24"
        android:strokeColor="#FFF5B942"
        android:strokeWidth="5.72"
        android:strokeLineCap="round" />

    <!-- 旗面：图标用的是更亮的琥珀 #FFC800，不是杆的 #F5B942 -->
    <path
        android:pathData="M146.34,86.8 L171.3,95.25 L146.34,103.7 Z"
        android:fillColor="#FFFFC800" />
</vector>
