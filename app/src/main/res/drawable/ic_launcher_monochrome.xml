<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 13+ 主题图标（Material You）用的单色层。
  系统会把整层染成壁纸取色，所以只保留剪影：山体 + 旗杆 + 旗面。
  雪帽与暗面在单色下会与山体同色、完全看不见，索性不放，剪影更干净。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.49"
        android:scaleY="0.49"
        android:translateX="25.58"
        android:translateY="24.6">
        <path
            android:pathData="M22,104 L58,36 L94,104 Z"
            android:fillColor="#FFFFFFFF" />
        <path
            android:pathData="M57.6,18.2 L57.6,34.8"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="4.4"
            android:strokeLineCap="round" />
        <path
            android:pathData="M59.8,16 L79,22.5 L59.8,29 Z"
            android:fillColor="#FFFFFFFF" />
    </group>
</vector>
